# Compose-level variables consumed directly by docker-compose.yml (postgres + backend DB connection settings).
# Copy this file to .env and fill in real values -- never commit the real .env.
#
# Everything else the backend needs at runtime (JWT_SECRET, FRONTEND_ORIGIN, etc.) lives in
# backend/.env.production -- see backend/.env.production.example.

DB_USERNAME=hugeworth
DB_PASSWORD=change-me-strong-random
DB_NAME=hugeworth_pms
