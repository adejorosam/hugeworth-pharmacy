NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=hugeworth_pms

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed frontend origins, e.g. https://app.hugeworthpharmacy.com
# Leave unset in local dev to allow any origin. MUST be set before deploying for real.
FRONTEND_ORIGIN=
