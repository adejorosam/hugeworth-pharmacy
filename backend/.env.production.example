# Non-DB backend settings for production, loaded via docker-compose.yml's `env_file: ./backend/.env.production`.
# DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_NAME are set by docker-compose.yml itself (from the root .env) and
# are NOT duplicated here.
#
# Copy this file to backend/.env.production and fill in real values -- never commit the real file.

NODE_ENV=production
PORT=3000
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=12h
# Comma-separated list of allowed frontend origins. Same-origin requests through nginx's /api proxy don't need
# this, but set it anyway as defense-in-depth -- e.g. http://<vps-ip>:8080
FRONTEND_ORIGIN=
# Optional, only used by `npm run seed` for the first admin account. seed.ts falls back to a default via `??`,
# which only works if these are truly UNSET -- a defined-but-empty "KEY=" line defeats that fallback and seeds a
# blank admin. Leave these lines OUT entirely unless you're setting a real value; don't uncomment with blanks.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
